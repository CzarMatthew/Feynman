# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Comma-separated emails allowed to sign in (leave empty to allow anyone)
ALLOWED_EMAILS=matthew@czar-nc.com

# Any long random string; Vercel Cron sends it automatically when set in Vercel
CRON_SECRET=make-a-long-random-string
